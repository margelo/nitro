{
  "name": "nitro",
  "description": "Fast, type-safe native modules for React Native with statically compiled JSI bindings.",
  "homepage": "https://nitro.margelo.com",
  "packageManager": "bun@1.3.14",
  "private": true,
  "version": "1.0.0-alpha.0",
  "repository": "https://github.com/margelo/nitro.git",
  "author": "Marc Rousavy <me@mrousavy.com> (https://github.com/mrousavy)",
  "workspaces": [
    "packages/nitro-core",
    "packages/nitrogen",
    "packages/react-native-nitro-modules",
    "scripts",
    "docs",
    "tests/standalone/nitro-test",
    "tests/standalone/nitro-test-external",
    "tests/standalone/test-runner",
    "tests/react-native/packages/*",
    "tests/react-native/apps/*"
  ],
  "scripts": {
    "postinstall": "bun run build",
    "build": "bun run build:core && bun nitro-rn build && bun nitro-rn-test build && bun nitro-rn-test-external build",
    "bootstrap": "bun install --frozen-lockfile",
    "typecheck": "bun nitro typecheck && bun nitrogen typecheck && bun nitro-rn typecheck && bun nitro-test-external typecheck && bun nitro-test typecheck && bun nitro-test-runner typecheck && bun nitro-rn-test-external typecheck && bun nitro-rn-test typecheck && bun example typecheck && bun benchmark typecheck && bun docs typecheck",
    "lint": "bun nitro lint && bun nitrogen lint && bun nitro-rn lint && bun nitro-rn-test-external lint && bun nitro-rn-test lint && bun example lint && bun benchmark lint",
    "lint-cpp": "bun format:cpp",
    "lint-swift": "bun format:swift",
    "lint-kotlin": "bun format:kotlin",
    "lint-all": "bun format && bun lint",
    "clean": "git clean -dfx",
    "release": "bun --filter @nitro/scripts release",
    "nitro": "bun --filter nitro-core",
    "nitrogen": "bun --filter nitrogen",
    "version:set": "bun --filter @nitro/scripts version:set",
    "check-versions": "bun --filter @nitro/scripts check-versions",
    "test:release": "bun --filter @nitro/scripts test:release",
    "docs": "bun --filter nitro-docs",
    "test:prepare": "bun run build:core && bun nitro-test-runner prepare-tests",
    "test:ios": "bun test:prepare && bun nitro-test-runner build:ios && bun nitro-test-runner test:ios",
    "test:android": "bun test:prepare && bun nitro-test-runner test:android",
    "build:core": "bun --filter @nitro/scripts build:core",
    "nitro-rn": "bun --filter react-native-nitro-modules",
    "nitro-rn-test": "bun --filter react-native-nitro-test",
    "nitro-rn-test-external": "bun --filter react-native-nitro-test-external",
    "nitro-test": "bun --filter nitro-test",
    "nitro-test-external": "bun --filter nitro-test-external",
    "nitro-test-runner": "bun --filter nitro-test-runner",
    "example": "bun --filter react-native-nitro-example",
    "benchmark": "bun --filter react-native-nitro-benchmark",
    "sync-core": "bun --filter @nitro/scripts sync-core",
    "bootstrap:ios": "bun bootstrap && bun example spm",
    "specs": "bun nitro-rn-test-external specs && bun nitro-rn-test specs && bun nitro-test specs",
    "test:staging": "bun --filter @nitro/scripts test:staging",
    "test:performance-tools": "bun test scripts/performance",
    "typecheck:performance-tools": "tsc -p scripts/performance/tsconfig.json",
    "test:react-native:ios": "bun example test:harness --harnessRunner ios",
    "test:react-native:android": "bun example test:harness --harnessRunner android",
    "check-consumer": "bun --filter @nitro/scripts check-consumer",
    "release:ci": "bun --filter @nitro/scripts release:ci",
    "format": "bun format:prettier --write && bun format:cpp && bun format:swift && bun format:kotlin",
    "format:check": "bun format:prettier --check && bun format:cpp --check && bun format:swift --check && bun format:kotlin --check",
    "format:prettier": "prettier . --ignore-path .gitignore --ignore-path config/format-ignore",
    "format:cpp": "bash scripts/clang-format.sh",
    "format:swift": "bash scripts/swift-format.sh",
    "format:kotlin": "bash scripts/kotlin-format.sh"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@jamesacarr/eslint-formatter-github-actions": "^0.2.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@tsconfig/react-native": "^3.0.9",
    "@types/jest": "^30.0.0",
    "@types/bun": "1.4.0",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.4",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.5.2",
    "prettier": "^3.8.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.0"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "patchedDependencies": {
    "@react-native-harness/ui@1.5.0": "patches/@react-native-harness%2Fui@1.5.0.patch",
    "@react-native-harness/platform-apple@1.5.0": "patches/@react-native-harness%2Fplatform-apple@1.5.0.patch",
    "@react-native-harness/platforms@1.5.0": "patches/@react-native-harness%2Fplatforms@1.5.0.patch",
    "@react-native-harness/jest@1.5.0": "patches/@react-native-harness%2Fjest@1.5.0.patch"
  },
  "prettier": {
    "printWidth": 140,
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "semi": false,
    "jsxSingleQuote": true,
    "proseWrap": "always"
  }
}
