{
  "name": "nitro",
  "description": "Fast, type-safe native modules for React Native with statically compiled JSI bindings.",
  "homepage": "https://nitro.margelo.com",
  "packageManager": "bun@1.3.14",
  "private": true,
  "version": "0.37.2-nightly.101.ge91b20f798c8",
  "repository": "https://github.com/margelo/nitro.git",
  "author": "Marc Rousavy <me@mrousavy.com> (https://github.com/mrousavy)",
  "workspaces": [
    "packages/nitro-core",
    "packages/nitrogen",
    "packages/react-native-nitro-modules",
    "docs",
    "tests/standalone/nitro-test",
    "tests/standalone/nitro-test-external",
    "tests/standalone/test-runner",
    "tests/react-native/packages/*",
    "tests/react-native/apps/*"
  ],
  "scripts": {
    "postinstall": "bun run build && bun install --ignore-scripts --frozen-lockfile",
    "build": "bun run build:core && bun nitro-rn build && bun nitro-rn-test build",
    "bootstrap": "bun install --frozen-lockfile",
    "typecheck": "bun nitro typecheck && bun nitrogen typecheck && bun nitro-rn typecheck && bun nitro-test-external typecheck && bun nitro-test typecheck && bun nitro-test-runner typecheck && bun nitro-rn-test typecheck && bun example typecheck && bun benchmark typecheck && bun docs typecheck",
    "lint": "bun nitro lint && bun nitrogen lint && bun nitro-rn lint && bun nitro-rn-test lint && bun example lint && bun benchmark lint",
    "lint-cpp": "./scripts/clang-format.sh",
    "lint-swift": "./scripts/swift-format.sh",
    "lint-kotlin": "./scripts/kotlin-format.sh",
    "lint-all": "bun lint-cpp && bun lint-swift && bun lint-kotlin && bun lint",
    "clean": "git clean -dfx",
    "release": "./scripts/release.sh",
    "nitro": "bun --cwd packages/nitro-core",
    "nitrogen": "bun --cwd packages/nitrogen",
    "version:set": "node scripts/set-version.mjs",
    "check-versions": "node scripts/set-version.mjs --check",
    "test:release": "node --test scripts/releases/*.test.mjs",
    "docs": "bun --cwd docs",
    "test:prepare": "bun run build:core && bun install --ignore-scripts --frozen-lockfile && bun nitro-test-runner prepare-tests",
    "test:ios": "bun test:prepare && bun nitro-test-runner test:ios",
    "test:android": "bun test:prepare && bun nitro-test-runner test:android",
    "build:core": "bun run check-versions && bun nitro build && bun nitrogen build",
    "nitro-rn": "bun --cwd packages/react-native-nitro-modules",
    "nitro-rn-test": "bun --cwd tests/react-native/packages/react-native-nitro-test",
    "nitro-test": "bun --cwd tests/standalone/nitro-test",
    "nitro-test-external": "bun --cwd tests/standalone/nitro-test-external",
    "nitro-test-runner": "bun --cwd tests/standalone/test-runner",
    "example": "bun --cwd tests/react-native/apps/example",
    "benchmark": "bun --cwd tests/react-native/apps/benchmark",
    "sync-core": "node scripts/sync-core.mjs",
    "bootstrap:ios": "bun bootstrap && bun example bundle-install && bun example pods",
    "specs": "bun nitro-rn-test specs && bun nitro-test specs",
    "test:staging": "node --test scripts/sync-core.test.mjs",
    "test:performance-tools": "bun test scripts/performance",
    "typecheck:performance-tools": "tsc -p scripts/performance/tsconfig.json",
    "test:react-native:ios": "bun example test:harness --harnessRunner ios",
    "test:react-native:android": "bun example test:harness --harnessRunner android"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@jamesacarr/eslint-formatter-github-actions": "^0.2.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@tsconfig/react-native": "^3.0.9",
    "@types/jest": "^30.0.0",
    "@types/bun": "1.4.0",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.4",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.5.2",
    "prettier": "^3.8.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.0"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  }
}
