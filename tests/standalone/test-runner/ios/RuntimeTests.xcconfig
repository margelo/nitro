NITRO_ROOT = $(SRCROOT)/../../../..
NITRO_NATIVE = $(NITRO_ROOT)/packages/nitro-core/native
NITRO_GENERATED = $(SRCROOT)/../../nitro-test/nitrogen/generated
NITRO_EXTERNAL_GENERATED = $(SRCROOT)/../../nitro-test-external/nitrogen/generated

SDKROOT = iphonesimulator
SUPPORTED_PLATFORMS = iphonesimulator
IPHONEOS_DEPLOYMENT_TARGET = 16.0
TARGETED_DEVICE_FAMILY = 1,2
CODE_SIGNING_ALLOWED = NO
ONLY_ACTIVE_ARCH = YES
CLANG_CXX_LANGUAGE_STANDARD = c++20
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES = YES
GCC_ENABLE_CPP_EXCEPTIONS = YES
GCC_ENABLE_CPP_RTTI = YES
SWIFT_VERSION = 5.0
SWIFT_OBJC_INTEROP_MODE = objcxx
GENERATE_INFOPLIST_FILE = YES
CURRENT_PROJECT_VERSION = 1
MARKETING_VERSION = 1.0

HEADERMAP_INCLUDES_PROJECT_HEADERS = YES
HEADERMAP_INCLUDES_FRAMEWORK_ENTRIES_FOR_ALL_PRODUCT_TYPES = YES
HEADER_SEARCH_PATHS = $(inherited) $(BUILT_PRODUCTS_DIR)/include $(DERIVED_SOURCES_DIR) $(NITRO_NATIVE)/cpp/** $(NITRO_NATIVE)/apple/** $(NITRO_GENERATED)/shared/** $(NITRO_GENERATED)/ios/** $(NITRO_EXTERNAL_GENERATED)/shared/** $(NITRO_EXTERNAL_GENERATED)/ios/** $(SRCROOT)/../cpp $(SRCROOT)/../../nitro-test/cpp
OTHER_CPLUSPLUSFLAGS = $(inherited) -Wno-nullability-completeness -Wno-nullability-extension
