{
  "name": "nitro-runtime-tests",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "specs": "bun nitrogen",
    "typecheck": "tsc --noEmit",
    "bundle": "bun scripts/bundle.ts",
    "prepare-tests": "bun run typecheck && bun run specs && bun run bundle",
    "test:ios": "bun ios/run.mjs",
    "test:android": "cd android && ./gradlew :connectedDebugAndroidTest"
  },
  "devDependencies": {
    "@types/chai": "5.2.3",
    "chai": "5.3.3",
    "nitro-core": "workspace:*",
    "nitrogen": "workspace:*"
  }
}
