{
  "name": "react-native-nitro-test",
  "version": "0.37.1",
  "description": "A testing playground library for Nitro Modules.",
  "main": "lib/index",
  "module": "lib/index",
  "types": "lib/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "react-native.config.js",
    "lib",
    "android/build.gradle",
    "android/gradle.properties",
    "android/CMakeLists.txt",
    "android/src",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.cpp",
    "ios/**/*.swift",
    "app.plugin.js",
    "*.podspec",
    "README.md"
  ],
  "keywords": [
    "react-native",
    "nitro",
    "test",
    "playground",
    "example"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/margelo/nitro.git",
    "directory": "tests/react-native/packages/react-native-nitro-test"
  },
  "author": "Marc Rousavy <me@mrousavy.com> (https://github.com/mrousavy)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/margelo/nitro/issues"
  },
  "homepage": "https://nitro.margelo.com/docs/guides/running-example-app",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun tsc",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\" --fix",
    "lint-ci": "eslint \"**/*.{js,ts,tsx}\" -f @jamesacarr/github-actions --max-warnings 0",
    "build-nitrogen-first": "bun --cwd ../../../.. build:core && bun --cwd ../../../.. nitro-rn build",
    "generate-external-first": "bun --cwd ../react-native-nitro-test-external specs",
    "specs": "bun build-nitrogen-first && bun generate-external-first && nitrogen --logLevel=\"debug\"",
    "clean": "rm -rf android/build node_modules/**/android/build lib"
  },
  "devDependencies": {
    "@types/jest": "*",
    "@types/react": "^19.3.0",
    "jest": "*",
    "nitrogen": "0.37.1",
    "@react-native/jest-preset": "0.88.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-nitro-test-external": "workspace:*"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "*",
    "react-native-nitro-test-external": "*"
  },
  "peerDependenciesMeta": {
    "react-native-nitro-modules": {
      "optional": true
    }
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "private": true
}
