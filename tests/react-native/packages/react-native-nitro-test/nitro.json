{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "test"
  ],
  "ios": {
    "iosModuleName": "NitroTest"
  },
  "android": {
    "androidNamespace": [
      "test"
    ],
    "androidCxxLibName": "NitroTest"
  },
  "autolinking": {
    "BenchmarkObjectCpp": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridBenchmarkObjectCpp"
      }
    },
    "BenchmarkObjectSwiftKotlin": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridBenchmarkObjectSwift"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridBenchmarkObjectKotlin"
      }
    },
    "TestView": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridTestView"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridTestView"
      }
    },
    "PaddedTestView": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridPaddedTestView"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridPaddedTestView"
      }
    },
    "RecyclableTestView": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridRecyclableTestView"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridRecyclableTestView"
      }
    },
    "GradientView": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridGradientView"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridGradientView"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}
