{
  "name": "react-native-nitro-test-external",
  "version": "1.0.0-alpha.nightly.102.g7b2ac8cfaaf9",
  "private": true,
  "description": "External view fixtures for Nitro React Native integration.",
  "main": "lib/index",
  "module": "lib/index",
  "types": "lib/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "apple",
    "android",
    "nitrogen/generated",
    "react-native.config.js",
    "*.podspec",
    "Package.swift"
  ],
  "scripts": {
    "build": "bun tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\" --fix",
    "lint-ci": "eslint \"**/*.{js,ts,tsx}\" -f @jamesacarr/github-actions --max-warnings 0",
    "build-nitrogen-first": "bun --filter @nitro/scripts build:core && bun --filter react-native-nitro-modules build",
    "specs": "bun build-nitrogen-first && nitrogen --logLevel=\"debug\""
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "nitrogen": "1.0.0-alpha.nightly.102.g7b2ac8cfaaf9",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-nitro-modules": "1.0.0-alpha.nightly.102.g7b2ac8cfaaf9"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.88.0",
    "react-native-nitro-modules": "*"
  },
  "imports": {
    "#nitro/*": "./nitrogen/generated/shared/javascript/*.cjs"
  },
  "swiftpmConfig": {
    "name": "NitroTestExternal",
    "dependencies": [
      "react-native-nitro-modules"
    ]
  }
}
