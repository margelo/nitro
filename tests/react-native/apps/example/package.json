{
  "name": "react-native-nitro-example",
  "version": "0.37.1",
  "private": true,
  "scripts": {
    "start": "node ../../../../scripts/sync-core.mjs && react-native start --client-logs",
    "android": "node ../../../../scripts/sync-core.mjs && react-native run-android",
    "ios": "node ../../../../scripts/sync-core.mjs && react-native run-ios",
    "clean": "rm -rf android/build node_modules/**/android/build lib",
    "typescript": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\" --fix",
    "lint-ci": "eslint \"**/*.{js,ts,tsx}\" -f @jamesacarr/github-actions --max-warnings 0",
    "bundle-install": "bundle install",
    "pods": "node ../../../../scripts/sync-core.mjs && cd ios && bundle exec pod install",
    "build:android": "node ../../../../scripts/sync-core.mjs && cd android && ./gradlew assembleDebug --no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a",
    "build:android-release": "node ../../../../scripts/sync-core.mjs && cd android && ./gradlew assembleRelease --no-daemon",
    "build:ios": "node ../../../../scripts/sync-core.mjs && cd ios && xcodebuild -workspace NitroExample.xcworkspace -scheme NitroExample -configuration Debug -sdk iphonesimulator GCC_OPTIMIZATION_LEVEL=0 GCC_PRECOMPILE_PREFIX_HEADER=YES ASSETCATALOG_COMPILER_OPTIMIZATION=time DEBUG_INFORMATION_FORMAT=dwarf COMPILER_INDEX_STORE_ENABLE=NO",
    "test:harness": "node ../../../../scripts/sync-core.mjs && react-native-harness"
  },
  "dependencies": {
    "@react-native-segmented-control/segmented-control": "^2.5.7",
    "@react-navigation/bottom-tabs": "^7.16.2",
    "@react-navigation/native": "^7.2.5",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-nitro-test": "workspace:*",
    "react-native-nitro-test-external": "workspace:*",
    "react-native-nitro-modules": "0.37.1",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.25.2",
    "nitro-core": "0.37.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@babel/runtime": "^8.0.7",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/eslint-config": "0.85.3",
    "@react-native/metro-config": "0.85.3",
    "@react-native/typescript-config": "0.85.3",
    "@react-native-harness/platform-android": "1.5.0",
    "@react-native-harness/platform-apple": "1.5.0",
    "@react-native-harness/ui": "1.5.0",
    "@types/upng-js": "2.1.5",
    "babel-plugin-module-resolver": "^5.0.3",
    "event-target-shim": "^6.0.2",
    "nitrogen": "0.37.1",
    "react-native-harness": "1.5.0",
    "upng-js": "2.1.0"
  },
  "engines": {
    "node": ">=20.19.4"
  }
}
