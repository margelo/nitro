{
  "name": "react-native-nitro-benchmark",
  "version": "0.37.1",
  "private": true,
  "scripts": {
    "android": "node ../../../../scripts/sync-core.mjs && react-native run-android --mode release",
    "ios": "node ../../../../scripts/sync-core.mjs && react-native run-ios --mode Release",
    "build:android": "node ../../../../scripts/sync-core.mjs && cd android && ./gradlew :app:assembleRelease --no-daemon",
    "build:ios": "node ../../../../scripts/sync-core.mjs && cd ios && xcodebuild -workspace NitroBenchmark.xcworkspace -scheme NitroBenchmark -configuration Release -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO",
    "bundle-install": "bundle install",
    "pods": "node ../../../../scripts/sync-core.mjs && cd ios && bundle exec pod install",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\" --fix",
    "lint-ci": "eslint \"**/*.{js,ts,tsx}\" -f @jamesacarr/github-actions --max-warnings 0"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-native": "0.87.1",
    "react-native-nitro-modules": "0.37.1",
    "react-native-nitro-test": "workspace:*",
    "react-native-nitro-test-external": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@babel/runtime": "^8.0.7",
    "@react-native-community/cli": "20.1.3",
    "@react-native-community/cli-platform-android": "20.1.3",
    "@react-native-community/cli-platform-ios": "20.1.3",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "codegenConfig": {
    "name": "ExampleTurboModule",
    "type": "modules",
    "jsSrcsDir": "src/turbo-module",
    "android": {
      "javaPackageName": "com.nitroexample.exampleturbomodule"
    }
  }
}
