{
  "name": "react-native-nitro-benchmark",
  "version": "1.0.0-alpha.nightly.86.g15e19db42041",
  "private": true,
  "scripts": {
    "sync-core": "bun --filter @nitro/scripts sync-core",
    "android": "bun sync-core && react-native run-android --mode release",
    "ios": "bun sync-core && react-native run-ios --mode Release",
    "build:android": "bun sync-core && cd android && ./gradlew :app:assembleRelease --no-daemon",
    "build:ios": "bun sync-core && cd ios && xcodebuild -project NitroBenchmark.xcodeproj -scheme NitroBenchmark -configuration Release -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\" --fix",
    "lint-ci": "eslint \"**/*.{js,ts,tsx}\" -f @jamesacarr/github-actions --max-warnings 0",
    "spm": "bun sync-core && react-native spm"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-nitro-modules": "1.0.0-alpha.nightly.86.g15e19db42041",
    "react-native-nitro-test": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@babel/runtime": "^8.0.7",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "codegenConfig": {
    "name": "ExampleTurboModule",
    "type": "modules",
    "jsSrcsDir": "src/turbo-module",
    "android": {
      "javaPackageName": "com.nitroexample.exampleturbomodule"
    }
  }
}
