{
  "name": "react-native-nitro-modules",
  "version": "1.0.0-alpha.nightly.100.g107f6fc66597",
  "description": "Fast, type-safe native modules for React Native with statically compiled JSI bindings.",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "react-native.config.js",
    "lib/commonjs",
    "lib/module",
    "lib/typescript",
    "android/build.gradle",
    "android/gradle.properties",
    "android/fix-prefab.gradle",
    "android/CMakeLists.txt",
    "android/src/",
    "android/core/",
    "apple/",
    "cpp/",
    "include/",
    "Package.swift",
    "README.md",
    "NitroModules.podspec",
    "LICENSE"
  ],
  "keywords": [
    "react-native",
    "nitro",
    "ios",
    "android",
    "visionOS",
    "tvOS",
    "macOS",
    "cpp",
    "framework",
    "react",
    "swift",
    "native",
    "modules",
    "fast",
    "jsi",
    "turbo",
    "scaffold",
    "template",
    "views"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/margelo/nitro.git",
    "directory": "packages/react-native-nitro-modules"
  },
  "author": "Marc Rousavy <me@mrousavy.com> (https://github.com/mrousavy)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/margelo/nitro/issues"
  },
  "homepage": "https://nitro.margelo.com",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun sync-core && rm -rf lib && bun typecheck && bob build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\" --fix",
    "lint-ci": "eslint \"**/*.{js,ts,tsx}\" -f @jamesacarr/github-actions --max-warnings 0",
    "clean": "rm -rf android/build node_modules/**/android/build lib",
    "release": "bun --filter @nitro/scripts release",
    "sync-core": "bun --filter @nitro/scripts sync-core",
    "prepack": "bun --filter @nitro/scripts check-versions 1>&2 && bun --filter nitro-core build 1>&2 && bun run build 1>&2 && bun sync-core --check 1>&2"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-builder-bob": "^0.41.0",
    "react-native-worklets": "^0.13.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.88.0"
  },
  "codegenConfig": {
    "name": "NitroModulesSpec",
    "type": "modules",
    "jsSrcsDir": "./src",
    "android": {
      "javaPackageName": "com.margelo.nitro"
    },
    "ios": {
      "modulesProvider": {
        "NitroModules": "NativeNitroModules"
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json",
          "tsc": "../../node_modules/typescript/bin/tsc"
        }
      ]
    ]
  },
  "dependencies": {
    "nitro-core": "1.0.0-alpha.nightly.100.g107f6fc66597"
  },
  "swiftpmConfig": {
    "name": "NitroModules"
  }
}
