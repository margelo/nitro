{
  "name": "nitro-core",
  "version": "0.37.1",
  "description": "Nitro's shared native runtime, JavaScript API, and TypeScript definitions.",
  "main": "./js/lib/commonjs/index.js",
  "module": "./js/lib/module/index.js",
  "types": "./js/lib/typescript/commonjs/index.d.ts",
  "react-native": "./js/lib/module/index.js",
  "source": "./js/src/index.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./js/lib/typescript/module/index.d.ts",
        "default": "./js/lib/module/index.js"
      },
      "import": {
        "types": "./js/lib/typescript/module/index.d.ts",
        "default": "./js/lib/module/index.js"
      },
      "require": {
        "types": "./js/lib/typescript/commonjs/index.d.ts",
        "default": "./js/lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "native/cpp",
    "native/apple",
    "native/android/src",
    "js/src",
    "js/lib/commonjs",
    "js/lib/module",
    "js/lib/typescript/commonjs",
    "js/lib/typescript/module",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/margelo/nitro.git",
    "directory": "packages/nitro-core"
  },
  "author": "Marc Rousavy <me@mrousavy.com> (https://github.com/mrousavy)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/margelo/nitro/issues"
  },
  "homepage": "https://nitro.margelo.com",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node js/build.mjs",
    "typecheck": "tsc -p js/tsconfig.json",
    "lint": "eslint \"js/src/**/*.ts\" --fix",
    "lint-ci": "eslint \"js/src/**/*.ts\" -f @jamesacarr/github-actions --max-warnings 0",
    "prepack": "bun --cwd ../.. check-versions 1>&2 && bun run build 1>&2",
    "clean": "rm -rf js/lib"
  }
}
